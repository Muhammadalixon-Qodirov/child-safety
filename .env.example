# Groq: https://console.groq.com/keys  (without a key Guardian runs in offline keyword mode)
GROQ_API_KEY=
# Check current model ids at https://console.groq.com/docs/models
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# Telegram: create a bot with @BotFather, then send /start to it
TELEGRAM_BOT_TOKEN=

# Public URL of this server (used in Telegram messages)
PUBLIC_URL=http://localhost:8000
# Shared secret for device clients calling /api/agent/*
AGENT_KEY=change-me
RETENTION_DAYS=7

# Vision (screenshot analysis) — Gemini API (https://aistudio.google.com/apikey)
# Roadmap: replaced by a local on-device multimodal model.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
